# Copy this file to .env and fill in your key. .env is never committed to git.

# Needed only for `python -m readingroom ask` (the standalone agent).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: which model `ask` uses. Any OpenRouter model that supports tool calling.
# READINGROOM_MODEL=openai/gpt-5-mini
